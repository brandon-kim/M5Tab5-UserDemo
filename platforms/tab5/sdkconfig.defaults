# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.4 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32p4"

#
# Bootloader config
#

#
# Log
#
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

#
# Format
#
CONFIG_BOOTLOADER_LOG_COLORS=y
# end of Format
# end of Log
# end of Bootloader config

#
# Serial flasher config
#
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# end of Serial flasher config

#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
# end of Partition Table

#
# Compiler options
#
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# end of Compiler options

#
# Component config
#

#
# HTTP Server
#
CONFIG_HTTPD_MAX_REQ_HDR_LEN=512
# end of HTTP Server

#
# Hardware Settings
#

#
# Chip revision
#
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
# end of Chip revision

#
# Sleep Config
#
CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND=n
# end of Sleep Config

CONFIG_ESP_ENABLE_PVT=n
# end of Hardware Settings

#
# ESP PSRAM
#
CONFIG_SPIRAM=y

#
# PSRAM config
#
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# end of PSRAM config
# end of ESP PSRAM

#
# ESP System Settings
#

#
# Cache config
#
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
# end of Cache config

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# end of ESP System Settings

#
# FAT Filesystem support
#
CONFIG_FATFS_VOLUME_COUNT=8
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_CODEPAGE_DYNAMIC=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
# end of FAT Filesystem support

#
# FreeRTOS
#

#
# Kernel
#
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# end of Kernel
# end of FreeRTOS

#
# Log
#
CONFIG_LOG_VERSION_2=y
# end of Log

#
# LWIP
#
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_SERVER_SUPPORT=y
# end of LWIP

#
# SPI Flash driver
#

#
# Auto-detect flash chips
#
CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=n
# end of Auto-detect flash chips
# end of SPI Flash driver

#
# LVGL configuration
#

#
# Rendering Configuration
#
CONFIG_LV_DRAW_BUF_ALIGN=128
# end of Rendering Configuration
# end of LVGL configuration

#
# ESP LVGL PORT
#
CONFIG_LVGL_PORT_ENABLE_PPA=y
# end of ESP LVGL PORT

#
# Board Support Package(m5stack_tab5)
#

#
# Display
#
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=3
# end of Display
# end of Board Support Package(m5stack_tab5)

#
# Espressif Camera Sensors Configurations
#

#
# Camera Sensor Configuration
#

#
# Select and Set Camera Sensor
#
CONFIG_CAMERA_SC202CS=y
# end of Select and Set Camera Sensor
# end of Camera Sensor Configuration

CONFIG_CAM_CTRL_SPI_ENABLE=n
# end of Espressif Camera Sensors Configurations

#
# ESP-Hosted config
#

#
# Hosted SDIO Configuration
#
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=13
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=12
CONFIG_ESP_HOSTED_SDIO_PIN_D0=11
CONFIG_ESP_HOSTED_SDIO_PRIV_PIN_D1_4BIT_BUS=10
CONFIG_ESP_HOSTED_SDIO_PIN_D2=9
CONFIG_ESP_HOSTED_SDIO_PIN_D3=8
# end of Hosted SDIO Configuration
# end of ESP-Hosted config

#
# Espressif Video Configuration
#
CONFIG_ESP_VIDEO_ENABLE_HW_JPEG_VIDEO_DEVICE=y
# end of Espressif Video Configuration

#
# Wi-Fi Remote
#
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
# end of Wi-Fi Remote
# end of Component config

CONFIG_IDF_EXPERIMENTAL_FEATURES=y
